#!/bin/bash
# Strips --clusters=all from scancel calls.
# Workaround for snakemake-executor-plugin-slurm on clusters where slurmdbd
# (port 6819) is not accessible.
THIS_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_SCANCEL=""
while IFS= read -r path; do
    if [[ "$path" != "$THIS_DIR/scancel" ]]; then
        REAL_SCANCEL="$path"
        break
    fi
done < <(which -a scancel 2>/dev/null)
[[ -z "$REAL_SCANCEL" ]] && { echo "scancel: command not found" >&2; exit 1; }
args=()
for arg in "$@"; do
    if [[ "$arg" == "--clusters="* ]]; then continue; fi
    args+=("$arg")
done
exec "$REAL_SCANCEL" "${args[@]}"
